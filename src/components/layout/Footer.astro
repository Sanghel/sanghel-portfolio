---
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-text">
      {t('footer.made_with')}
      <span aria-hidden="true" style="color: #a855f7;">♥</span>
      {t('footer.and')}
      <img
        class="footer-astro-icon"
        src="https://cdn.simpleicons.org/astro/FF5D01"
        alt="Astro"
        width="16"
        height="16"
        loading="lazy"
        decoding="async"
        title="Astro"
      />
      {t('footer.by')}
    </p>
    <a href="#" class="footer-top" aria-label="Back to top">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 12V4M8 4L4 8M8 4L12 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-block: 1.75rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-text {
    font-size: 0.8125rem;
    color: #475569;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .footer-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: #64748b;
    text-decoration: none;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .footer-top:hover {
    color: #f1f5f9;
    border-color: rgba(168, 85, 247, 0.4);
    background: rgba(124, 58, 237, 0.1);
    transform: translateY(-2px);
  }

  .footer-astro-icon {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    vertical-align: -0.15em;
    object-fit: contain;
  }
</style>

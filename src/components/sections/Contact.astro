---
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;

const email = 'sanghelgonzalez@gmail.com';
const socials = [
  {
    name: 'GitHub',
    url: 'https://github.com/sanghel',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/sanghelgonzalez',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<section id="contact" class="section" aria-label="Contact">
  <div class="container">
    <div class="contact-wrapper">
      <!-- Background decoration -->
      <div class="contact-glow" aria-hidden="true"></div>

      <div class="contact-content">
        <p class="section-label reveal">{t('contact.section_label')}</p>
        <h2 class="contact-heading reveal">{t('contact.heading')}</h2>
        <p class="contact-sub reveal">{t('contact.subheading')}</p>

        <!-- Email copy button -->
        <div class="email-block reveal">
          <span class="email-label">{t('contact.email_label')}</span>
          <div class="email-row">
            <a href={`mailto:${email}`} class="email-text">{email}</a>
            <button
              class="copy-btn"
              data-email={email}
              data-copy={t('contact.copy')}
              data-copied={t('contact.copied')}
              aria-label={`Copy email ${email}`}
            >
              <span class="copy-text">{t('contact.copy')}</span>
              <span class="icon-slot">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="copy-icon">
                  <rect x="4" y="4" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M2 10V3a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="check-icon">
                  <path d="M2 7l4 4 6-7" stroke="#a855f7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
          </div>
        </div>

        <!-- Divider -->
        <div class="contact-divider reveal">
          <span class="divider-line"></span>
          <span class="divider-text">{t('contact.or')}</span>
          <span class="divider-line"></span>
        </div>

        <!-- Social links -->
        <div class="social-links reveal-stagger">
          {socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link glass glass-hover"
              aria-label={s.name}
            >
              <Fragment set:html={s.icon} />
              <span>{s.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-wrapper {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    padding: 4rem 2rem;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }

  .contact-glow {
    position: absolute;
    inset: -1px;
    border-radius: 24px;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(124, 58, 237, 0.12), transparent);
    pointer-events: none;
  }

  .contact-content {
    position: relative;
    z-index: 1;
  }

  .contact-heading {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #f1f5f9;
    margin: 0 0 1rem;
  }

  .contact-sub {
    font-size: 0.9375rem;
    color: #64748b;
    line-height: 1.65;
    margin: 0 0 2.5rem;
  }

  /* ─── Email block ──── */
  .email-block {
    margin-bottom: 1.75rem;
    text-align: left;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }

  .email-label {
    display: block;
    font-size: 0.6875rem;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #475569;
    margin-bottom: 6px;
  }

  .email-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .email-text {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #f1f5f9;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .email-text:hover { color: #a855f7; }

  .copy-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 7px;
    background: rgba(124, 58, 237, 0.12);
    border: 1px solid rgba(124, 58, 237, 0.2);
    color: #a855f7;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .copy-btn:hover {
    background: rgba(124, 58, 237, 0.2);
    border-color: rgba(168, 85, 247, 0.4);
  }

  .icon-slot {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .copy-icon,
  .check-icon {
    position: absolute;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .check-icon {
    opacity: 0;
  }

  .copy-btn.copied {
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.4);
    color: #a855f7;
  }

  .copy-btn.copied .copy-icon {
    opacity: 0;
  }

  .copy-btn.copied .check-icon {
    opacity: 1;
    animation: check-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes check-pop {
    from { transform: scale(0.6); opacity: 0; }
    70%  { transform: scale(1.1); }
    to   { transform: scale(1);   opacity: 1; }
  }

  /* ─── Divider ──── */
  .contact-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.75rem;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
  }

  .divider-text {
    font-size: 0.75rem;
    color: #475569;
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
  }

  /* ─── Socials ──── */
  .social-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .social-link:hover {
    color: #f1f5f9;
    transform: translateY(-2px);
  }
</style>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('.copy-btn');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 2000);
    } catch {
      // no-op
    }
  });
</script>

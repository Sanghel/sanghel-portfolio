---
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;

const stats = [
  { key: 'stat_years', valueKey: 'stat_years_value' },
  { key: 'stat_projects', valueKey: 'stat_projects_value' },
  { key: 'stat_technologies', valueKey: 'stat_technologies_value' },
];
---

<section id="about" class="section" aria-label="About">
  <div class="container">
    <div class="about-grid">
      <!-- Avatar column -->
      <div class="about-avatar-col reveal-left">
        <div class="avatar-wrapper">
          <div class="avatar-glow"></div>
          <div class="avatar-frame">
            <img
              src="/public/sanghel_profile_edited.webp"
              alt="Sanghel González"
              class="avatar-img"
              width="320"
              height="320"
              loading="lazy"
              onerror="this.style.display='none';this.parentElement.querySelector('.avatar-placeholder').style.display='flex';"
            />
            <div class="avatar-placeholder">
              <span>SG</span>
            </div>
          </div>
          <!-- Floating badge -->
          <div class="avatar-badge">
            <span class="dot"></span>
            Available for hire
          </div>
        </div>
      </div>

      <!-- Text column -->
      <div class="about-text-col">
        <p class="section-label reveal">{t('about.section_label')}</p>
        <h2 class="about-heading reveal">
          {t('about.heading').split('\n').map((line: string) => (
            <span>{line}<br /></span>
          ))}
        </h2>

        <p class="about-bio reveal">{t('about.bio_1')}</p>
        <p class="about-bio reveal">{t('about.bio_2')}</p>

        <!-- Stats -->
        <div class="stats-row reveal-stagger">
          {stats.map(({ key, valueKey }) => (
            <div class="stat-item glass">
              <span class="stat-value gradient-text" data-target={t(`about.${valueKey}`)}>
                {t(`about.${valueKey}`)}
              </span>
              <span class="stat-label">{t(`about.${key}`)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-avatar-col {
      order: -1;
      display: flex;
      justify-content: center;
    }
  }

  /* ─── Avatar ──── */
  .avatar-wrapper {
    position: relative;
    display: inline-block;
  }

  .avatar-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .avatar-frame {
    position: relative;
    width: clamp(240px, 35vw, 320px);
    height: clamp(240px, 35vw, 320px);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-placeholder {
    display: none;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(6,182,212,0.1));
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    color: #a855f7;
    letter-spacing: -0.03em;
  }

  .avatar-badge {
    position: absolute;
    bottom: -16px;
    right: -16px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 99px;
    background: rgba(3, 7, 18, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #94a3b8;
    white-space: nowrap;
  }

  .avatar-badge .dot {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulse-green 2s ease-in-out infinite;
  }

  @keyframes pulse-green {
    0%, 100% { box-shadow: 0 0 4px #22c55e; }
    50% { box-shadow: 0 0 12px #22c55e; }
  }

  /* ─── Text ──── */
  .about-heading {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    color: #f1f5f9;
    margin: 0 0 1.5rem;
    line-height: 1.2;
  }

  .about-bio {
    font-size: 0.9375rem;
    color: #94a3b8;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  /* ─── Stats ──── */
  .stats-row {
    display: flex;
    gap: 12px;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .stat-item {
    flex: 1;
    min-width: 100px;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.3;
  }
</style>

<script>
  // Vanilla counter — no GSAP needed, saves ~80KB of JS
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    function animateCounter(el: HTMLElement, target: number, suffix: string) {
      const duration = 1400;
      const start = performance.now();

      const tick = (now: number) => {
        const elapsed = Math.min(now - start, duration);
        const progress = elapsed / duration;
        // Cubic ease-out: fast start, slow end
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const raw = el.dataset.target ?? '0';
        const suffix = raw.replace(/[0-9]/g, '');
        const target = parseInt(raw, 10);
        animateCounter(el, target, suffix);
        io.unobserve(el);
      });
    }, { threshold: 0.5 });

    document.querySelectorAll<HTMLElement>('.stat-value[data-target]').forEach((el) => {
      io.observe(el);
    });
  }
</script>

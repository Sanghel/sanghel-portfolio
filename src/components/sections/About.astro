---
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;

const stats = [
  { key: 'stat_years', valueKey: 'stat_years_value' },
  { key: 'stat_projects', valueKey: 'stat_projects_value' },
  { key: 'stat_technologies', valueKey: 'stat_technologies_value' },
];
---

<section id="about" class="section" aria-label="About">
  <div class="container">
    <div class="about-grid">
      <!-- Avatar column -->
      <div class="about-avatar-col reveal-left">
        <div class="avatar-wrapper">
          <div class="avatar-glow"></div>
          <!-- Photo with Thanos dissolve effect -->
          <div class="avatar-frame" id="avatar-frame" role="img" aria-label="Sanghel González — hover to reveal">
            <canvas id="avatar-canvas" class="avatar-canvas" aria-hidden="true"></canvas>
            <img
              id="img-front"
              src="/sanghel_profile_edited.webp"
              alt=""
              class="avatar-img-src"
              width="320"
              height="320"
              loading="eager"
            />
            <img
              id="img-back"
              src="/sanghel_profile_real.webp"
              alt=""
              class="avatar-img-src"
              width="320"
              height="320"
              loading="eager"
              onerror="this.dataset.failed='true'"
            />
          </div>
          <!-- Floating badge -->
          <div class="avatar-badge">
            <span class="dot"></span>
            Available for hire
          </div>
        </div>
      </div>

      <!-- Text column -->
      <div class="about-text-col">
        <p class="section-label reveal">{t('about.section_label')}</p>
        <h2 class="about-heading reveal">
          {t('about.heading').split('\n').map((line: string) => (
            <span>{line}<br /></span>
          ))}
        </h2>

        <p class="about-bio reveal">{t('about.bio_1')}</p>
        <p class="about-bio reveal">{t('about.bio_2')}</p>

        <!-- Stats -->
        <div class="stats-row reveal-stagger">
          {stats.map(({ key, valueKey }) => (
            <div class="stat-item glass">
              <span class="stat-value gradient-text" data-target={t(`about.${valueKey}`)}>
                {t(`about.${valueKey}`)}
              </span>
              <span class="stat-label">{t(`about.${key}`)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-avatar-col {
      order: -1;
      display: flex;
      justify-content: center;
    }
  }

  /* ─── Avatar ──── */
  .avatar-wrapper {
    position: relative;
    display: inline-block;
  }

  .avatar-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(184, 186, 255, 0.18) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  /* ─── Photo frame ──── */
  .avatar-frame {
    position: relative;
    width: clamp(240px, 35vw, 320px);
    height: clamp(240px, 35vw, 320px);
    border-radius: 24px;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }

  .avatar-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    display: block;
  }

  /* Hidden image sources (used only as drawImage input) */
  .avatar-img-src {
    display: none;
  }

.avatar-badge {
    position: absolute;
    bottom: -16px;
    right: -16px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 99px;
    background: rgba(12, 12, 22, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #94a3b8;
    white-space: nowrap;
  }

  .avatar-badge .dot {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulse-green 2s ease-in-out infinite;
  }

  @keyframes pulse-green {
    0%, 100% { box-shadow: 0 0 4px #22c55e; }
    50% { box-shadow: 0 0 12px #22c55e; }
  }

  /* ─── Text ──── */
  .about-heading {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    color: #f1f5f9;
    margin: 0 0 1.5rem;
    line-height: 1.2;
  }

  .about-bio {
    font-size: 0.9375rem;
    color: #94a3b8;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  /* ─── Stats ──── */
  .stats-row {
    display: flex;
    gap: 12px;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .stat-item {
    flex: 1;
    min-width: 100px;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #94a3b8;
    line-height: 1.3;
  }
</style>

<script>
  // ─── Thanos dissolve + materialize effect ────────────────────────────────
  // The <img> elements are display:none — the canvas is the only thing on
  // screen, so if this never runs the avatar is simply blank. It must re-run
  // after every view transition (e.g. the language toggle), not just on load.
  function initAvatar() {
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const frame    = document.getElementById('avatar-frame')  as HTMLDivElement    | null;
  const canvas   = document.getElementById('avatar-canvas') as HTMLCanvasElement | null;
  const imgFront = document.getElementById('img-front')     as HTMLImageElement  | null;
  const imgBack  = document.getElementById('img-back')      as HTMLImageElement  | null;

  // The flag lives on the node itself: a view transition swaps in a fresh
  // element, so it is absent again and we re-wire, but a double call on the
  // same DOM is a no-op.
  if (frame && canvas && imgFront && imgBack && !frame.dataset.avatarReady) {
    frame.dataset.avatarReady = '1';
    const SIZE = 320;
    canvas.width  = SIZE;
    canvas.height = SIZE;
    const ctx = canvas.getContext('2d')!;
    const TILE = 5;

    let offFront: HTMLCanvasElement | null = null;
    let offBack:  HTMLCanvasElement | null = null;
    let animId:   number | null = null;
    let targetFace: 'front' | 'back' = 'front';
    let currentFace: 'front' | 'back' = 'front';

    function makeOff(imgEl: HTMLImageElement): HTMLCanvasElement {
      const off = document.createElement('canvas');
      off.width  = SIZE;
      off.height = SIZE;
      off.getContext('2d')!.drawImage(imgEl, 0, 0, SIZE, SIZE);
      return off;
    }

    function snapshotCanvas(): HTMLCanvasElement {
      const snap = document.createElement('canvas');
      snap.width  = SIZE;
      snap.height = SIZE;
      snap.getContext('2d')!.drawImage(canvas, 0, 0);
      return snap;
    }

    function drawStatic(src: HTMLCanvasElement) {
      ctx.clearRect(0, 0, SIZE, SIZE);
      ctx.globalAlpha = 1;
      ctx.drawImage(src, 0, 0);
    }

    interface Particle {
      x: number; y: number; w: number; h: number;
      vx: number; vy: number; gravity: number; delay: number;
    }

    function buildParticles(): Particle[] {
      const ps: Particle[] = [];
      for (let y = 0; y < SIZE; y += TILE) {
        for (let x = 0; x < SIZE; x += TILE) {
          const angle = (Math.random() - 0.5) * Math.PI * 0.85;
          const speed = Math.random() * 2.8 + 0.6;
          const side  = Math.random() < 0.5 ? 1 : -1;
          ps.push({
            x, y,
            w: Math.min(TILE, SIZE - x),
            h: Math.min(TILE, SIZE - y),
            vx: Math.cos(angle) * speed * side,
            vy: Math.sin(angle) * speed - Math.random() * 1.8,
            gravity: Math.random() * 0.07 + 0.02,
            delay: Math.random() * 0.45,
          });
        }
      }
      return ps;
    }

    function cancelAnim() {
      if (animId !== null) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    }

    const SPREAD   = 110;
    const OUT_DUR  = 1050; // ms — disintegration
    const IN_DUR   = 1000; // ms — materialization

    // Phase 1: source tiles fly away, canvas empties
    function runDisintegrate(src: HTMLCanvasElement, onDone: () => void) {
      cancelAnim();
      const particles = buildParticles();
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / OUT_DUR, 1);
        ctx.clearRect(0, 0, SIZE, SIZE);

        for (const p of particles) {
          const lp    = Math.min(1, Math.max(0, (progress - p.delay) / (1 - p.delay + 1e-4)));
          const alpha = 1 - lp;
          if (alpha < 0.02) continue;

          const ease = lp * lp; // accelerates over time
          const dx = p.vx * ease * SPREAD;
          const dy = p.vy * ease * SPREAD + p.gravity * ease * SPREAD * 8;

          ctx.globalAlpha = alpha;
          ctx.drawImage(src, p.x, p.y, p.w, p.h, p.x + dx, p.y + dy, p.w, p.h);
        }

        ctx.globalAlpha = 1;

        if (progress < 1) {
          animId = requestAnimationFrame(tick);
        } else {
          animId = null;
          ctx.clearRect(0, 0, SIZE, SIZE);
          onDone();
        }
      };

      animId = requestAnimationFrame(tick);
    }

    // Phase 2: destination tiles fly in from scattered positions and assemble
    function runMaterialize(dest: HTMLCanvasElement, onDone: () => void) {
      cancelAnim();
      const particles = buildParticles();
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / IN_DUR, 1);
        ctx.clearRect(0, 0, SIZE, SIZE);

        for (const p of particles) {
          const lp    = Math.min(1, Math.max(0, (progress - p.delay) / (1 - p.delay + 1e-4)));
          const alpha = lp;
          if (alpha < 0.02) continue;

          // Reverse: displaced at start, converges to correct position
          const ease = (1 - lp) * (1 - lp);
          const dx = p.vx * ease * SPREAD;
          const dy = p.vy * ease * SPREAD + p.gravity * ease * SPREAD * 8;

          ctx.globalAlpha = alpha;
          ctx.drawImage(dest, p.x, p.y, p.w, p.h, p.x + dx, p.y + dy, p.w, p.h);
        }

        ctx.globalAlpha = 1;

        if (progress < 1) {
          animId = requestAnimationFrame(tick);
        } else {
          animId = null;
          drawStatic(dest);
          onDone();
        }
      };

      animId = requestAnimationFrame(tick);
    }

    function transitionTo(target: 'front' | 'back') {
      if (target === targetFace) return;
      targetFace = target;

      const dest = target === 'back' ? offBack : offFront;
      if (!dest) return;

      if (prefersReducedMotion) {
        cancelAnim();
        drawStatic(dest);
        currentFace = target;
        return;
      }

      // Snapshot whatever is on canvas right now (handles mid-animation reversals)
      const snapshot = snapshotCanvas();
      cancelAnim();

      runDisintegrate(snapshot, () => {
        if (targetFace !== target) return; // direction changed while animating
        runMaterialize(dest, () => {
          currentFace = target;
        });
      });
    }

    function init() {
      offFront = makeOff(imgFront);
      drawStatic(offFront);
    }

    function cacheBack() {
      if (!imgBack.dataset.failed) offBack = makeOff(imgBack);
    }

    if (imgFront.complete) init();
    else imgFront.addEventListener('load', init, { once: true });

    if (imgBack.complete) cacheBack();
    else imgBack.addEventListener('load', cacheBack, { once: true });

    // Mouse hover (desktop)
    const hasHover = window.matchMedia('(hover: hover)').matches;
    if (hasHover) {
      frame.addEventListener('mouseenter', () => transitionTo('back'));
      frame.addEventListener('mouseleave', () => transitionTo('front'));
    } else {
      // Touch: tap to toggle
      frame.addEventListener('click', () => {
        transitionTo(targetFace === 'front' ? 'back' : 'front');
      });
    }
  }
  }

  // ─── Stats counter ────────────────────────────────────────────────────────
  function initStats() {
  const prefersReducedMotionStats = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotionStats) {
    function animateCounter(el: HTMLElement, target: number, suffix: string) {
      const duration = 1400;
      const start = performance.now();

      const tick = (now: number) => {
        const elapsed = Math.min(now - start, duration);
        const progress = elapsed / duration;
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const raw = el.dataset.target ?? '0';
        const suffix = raw.replace(/[0-9]/g, '');
        const target = parseInt(raw, 10);
        animateCounter(el, target, suffix);
        io.unobserve(el);
      });
    }, { threshold: 0.5 });

    document.querySelectorAll<HTMLElement>('.stat-value[data-target]').forEach((el) => {
      if (el.dataset.counterReady) return;
      el.dataset.counterReady = '1';
      io.observe(el);
    });
  }
  }

  function initAbout() {
    initAvatar();
    initStats();
  }

  initAbout();
  // Module scripts run once; view transitions swap the DOM without re-running
  // them, so re-init on every navigation too.
  document.addEventListener('astro:page-load', initAbout);
</script>

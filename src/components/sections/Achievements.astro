---
import type { Lang } from '../../i18n/utils';
import { achievements } from '../../content/projects';

interface Props {
  t: (key: string) => string;
  lang: Lang;
}

const { t } = Astro.props;
---

<section id="achievements" class="section" aria-label="Achievements">
  <div class="container">
    <p class="section-label reveal">{t('achievements.section_label')}</p>
    <h2 class="achievements-heading reveal">{t('achievements.heading')}</h2>
    <p class="achievements-sub reveal">{t('achievements.subheading')}</p>

    <div class="achievements-grid">
      {achievements.map((achievement, idx) => (
        <div class={`achievement-card glass glass-hover reveal`} style={`--delay: ${idx * 0.1}s`}>
          <div class={`award-icon-wrap icon-${achievement.icon}`}>
            {achievement.icon === 'genius' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18h6M10 22h4M12 2a7 7 0 0 1 7 7c0 2.5-1.3 4.7-3.3 6L15 17H9l-.7-2C6.3 13.7 5 11.5 5 9a7 7 0 0 1 7-7z"/>
              </svg>
            )}
            {achievement.icon === 'champion' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9H4.5a2.5 2.5 0 0 0 0 5H6M18 9h1.5a2.5 2.5 0 0 1 0 5H18M6 9V5h12v4M6 14v5h12v-5M9 21h6M12 5V3"/>
              </svg>
            )}
            {achievement.icon === 'teamplayer' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            )}
          </div>

          <div class="award-body">
            <h3 class="award-title">{achievement.title[Astro.props.lang]}</h3>
            <span class="award-year">{achievement.year}</span>
          </div>

          <p class="award-description">{achievement.description[Astro.props.lang]}</p>

          <p class="award-issuer">{achievement.issuer}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #f1f5f9;
    margin: 0.5rem 0 1rem;
    line-height: 1.2;
  }

  .achievements-sub {
    font-size: 1rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 0 3.5rem;
    line-height: 1.7;
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .achievements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .achievements-grid {
      grid-template-columns: 1fr;
    }
  }

  .achievement-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 16px;
    animation-delay: var(--delay, 0s);
  }

  /* Icon wrapper */
  .award-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    flex-shrink: 0;
  }

  .icon-genius {
    background: linear-gradient(135deg, rgba(184, 186, 255, 0.2), rgba(201, 232, 255, 0.15));
    color: #B8BAFF;
    border: 1px solid rgba(184, 186, 255, 0.25);
  }

  .icon-champion {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .icon-teamplayer {
    background: rgba(6, 182, 212, 0.12);
    color: #06b6d4;
    border: 1px solid rgba(6, 182, 212, 0.2);
  }

  .award-body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .award-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
    line-height: 1.3;
  }

  .award-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #475569;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2px 8px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .award-description {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .award-issuer {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #B8BAFF;
    margin: 0;
    padding-top: 0.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
</style>

<script>
  // Re-use the reveal observer already present in the page
  function initAchievements() {
  const cards = document.querySelectorAll('#achievements .reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  cards.forEach((el) => {
    if ((el as HTMLElement).dataset.achReady) return;
    (el as HTMLElement).dataset.achReady = '1';
    observer.observe(el);
  });
  }

  initAchievements();
  // Module scripts run once; view transitions swap the DOM without re-running
  // them, so re-init on every navigation too.
  document.addEventListener('astro:page-load', initAchievements);
</script>

---
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;
---

<section id="hero" class="hero" aria-label="Hero">
  <!-- Gradient mesh background -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero-blob hero-blob-3"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="container hero-content">
    <!-- Greeting badge — animated via CSS @keyframes (works in all browsers) -->
    <div class="hero-badge hero-anim-1" id="hero-badge">
      <span class="hero-badge-dot"></span>
      <span>{t('hero.greeting')}</span>
    </div>

    <!-- Name heading -->
    <h1 class="hero-name hero-anim-2" id="hero-name">
      <span class="hero-name-text gradient-text">{t('hero.name')}</span>
    </h1>

    <!-- Role -->
    <p class="hero-role hero-anim-3" id="hero-role">{t('hero.role')}</p>

    <!-- Tagline -->
    <p class="hero-tagline hero-anim-4" id="hero-tagline">{t('hero.tagline')}</p>

    <!-- CTAs -->
    <div class="hero-ctas hero-anim-5" id="hero-ctas">
      <a href="#projects" class="cta-primary">
        {t('hero.cta_primary')}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/sanghel_cv.pdf" download class="cta-secondary">{t('hero.cta_secondary')}</a>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator hero-anim-6" id="hero-scroll" aria-hidden="true">
      <span class="scroll-line"></span>
      <span class="scroll-label">{t('hero.scroll')}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;     /* Safari < 15.4 fallback */
    min-height: 100svh;    /* Modern: excludes mobile browser chrome */
    display: -webkit-flex;
    display: flex;
    -webkit-align-items: center;
    align-items: center;
    overflow: hidden;
  }

  /* ─── Background blobs ──── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
  }

  .hero-blob-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #B8BAFF 0%, transparent 70%);
    top: -200px;
    right: -100px;
    animation: float1 12s ease-in-out infinite;
  }

  .hero-blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #B9F0D7 0%, transparent 70%);
    bottom: -100px;
    left: -50px;
    opacity: 0.2;
    animation: float2 15s ease-in-out infinite;
  }

  .hero-blob-3 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, #C9E8FF 0%, transparent 70%);
    top: 40%;
    left: 40%;
    opacity: 0.15;
    animation: float3 10s ease-in-out infinite;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 0%, transparent 100%);
  }

  @keyframes float1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-30px, 20px) scale(1.05); }
    66% { transform: translate(20px, -15px) scale(0.95); }
  }

  @keyframes float2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, -25px) scale(1.08); }
  }

  @keyframes float3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-15px, 20px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-blob { animation: none; }
  }

  /* ─── Content ──── */
  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 96px;
    padding-bottom: 80px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 99px;
    background: rgba(184, 186, 255, 0.10);
    border: 1px solid rgba(184, 186, 255, 0.25);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #C9E8FF;
    margin-bottom: 1.75rem;
  }

  .hero-badge-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #B8BAFF;
    box-shadow: 0 0 6px #B8BAFF;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px #B8BAFF; }
    50% { opacity: 0.6; box-shadow: 0 0 12px #B8BAFF; }
  }

  .hero-name {
    font-size: clamp(2.75rem, 8vw, 6rem);
    line-height: 1.05;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
  }

  .hero-name-text {
    display: block;
  }

  .hero-role {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: #64748b;
    margin: 0 0 1.25rem;
    letter-spacing: -0.01em;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: #64748b;
    max-width: 520px;
    line-height: 1.65;
    margin: 0 0 2.5rem;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 10px;
    background: linear-gradient(135deg, #B8BAFF, #C9E8FF);
    color: #0c0c16;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 24px rgba(184, 186, 255, 0.30);
  }

  .cta-primary:hover {
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(184, 186, 255, 0.40);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .cta-secondary:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  /* ─── Scroll indicator ──── */
  .scroll-indicator {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4rem;
    color: #475569;
  }

  .scroll-line {
    display: block;
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, #B8BAFF, transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: #C9E8FF;
    animation: slide-right 2s ease-in-out infinite;
  }

  @keyframes slide-right {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  .scroll-label {
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ─── Hero entrance: pure CSS animation — works in Safari, Chrome, Firefox ── */
  @-webkit-keyframes hero-in {
    from {
      opacity: 0;
      -webkit-transform: translateY(22px);
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      -webkit-transform: translateY(0);
      transform: translateY(0);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      -webkit-transform: translateY(22px);
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      -webkit-transform: translateY(0);
      transform: translateY(0);
    }
  }

  /* Shared animation — fill:both keeps element hidden before delay fires */
  .hero-anim-1,
  .hero-anim-2,
  .hero-anim-3,
  .hero-anim-4,
  .hero-anim-5,
  .hero-anim-6 {
    -webkit-animation-name: hero-in;
    animation-name: hero-in;
    -webkit-animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    -webkit-animation-fill-mode: both;
    animation-fill-mode: both;
  }

  .hero-anim-1 { -webkit-animation-duration: 0.55s; animation-duration: 0.55s; -webkit-animation-delay: 0.15s; animation-delay: 0.15s; }
  .hero-anim-2 { -webkit-animation-duration: 0.75s; animation-duration: 0.75s; -webkit-animation-delay: 0.3s;  animation-delay: 0.3s;  }
  .hero-anim-3 { -webkit-animation-duration: 0.6s;  animation-duration: 0.6s;  -webkit-animation-delay: 0.5s;  animation-delay: 0.5s;  }
  .hero-anim-4 { -webkit-animation-duration: 0.6s;  animation-duration: 0.6s;  -webkit-animation-delay: 0.64s; animation-delay: 0.64s; }
  .hero-anim-5 { -webkit-animation-duration: 0.55s; animation-duration: 0.55s; -webkit-animation-delay: 0.78s; animation-delay: 0.78s; }
  .hero-anim-6 { -webkit-animation-duration: 0.45s; animation-duration: 0.45s; -webkit-animation-delay: 1s;    animation-delay: 1s;    }

  @media (prefers-reduced-motion: reduce) {
    .hero-anim-1,
    .hero-anim-2,
    .hero-anim-3,
    .hero-anim-4,
    .hero-anim-5,
    .hero-anim-6 {
      -webkit-animation: none;
      animation: none;
      opacity: 1;
      -webkit-transform: none;
      transform: none;
    }
  }
</style>

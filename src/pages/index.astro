---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import Timeline from '../components/sections/Timeline.astro';
import Contact from '../components/sections/Contact.astro';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  title="Sanghel González — Software Developer"
  description="Software Developer with 4+ years of experience crafting fast, accessible, and beautiful web experiences."
>
  <Navbar lang={lang} t={t} />

  <main>
    <Hero t={t} />
    <About t={t} />
    <Projects t={t} lang={lang} />
    <Skills t={t} />
    <Timeline t={t} lang={lang} />
    <Contact t={t} />
  </main>

  <Footer t={t} />
</Layout>
